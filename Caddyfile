:80 {
    # ── API routes ──────────────────────────────────────────────────────────
    @api {
        path /auth/* /users/*
        path /portfolio* /dashboard* /timeseries* /transactions*
        path /optimizer* /projection* /strategy* /bengen* /scan*
        path /brokers* /envelopes/* /profile*
        path /watchlist* /powens* /sync/* /webhooks/* /accounts*
        path /admin* /health
    }

    handle @api {
        reverse_proxy backend:8000 {
            # Cloudflare termine le TLS ; Caddy écoute en :80 et déduirait
            # X-Forwarded-Proto: http. On force https car le client a TOUJOURS
            # parlé en HTTPS à Cloudflare. Sans ça, backend génère du http://
            # dans request.url_for (cassait OAuth redirect_uri, cf ADR-014).
            header_up X-Forwarded-Proto https
        }
    }

    # ── Static SPA (everything else) ────────────────────────────────────────
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server

        @hashed {
            path *.js *.css *.woff2 *.png *.jpg *.svg *.ico
        }
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache, must-revalidate"
    }

    encode gzip zstd
    log {
        output stdout
    }
}
