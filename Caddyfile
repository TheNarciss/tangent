:80 {
    # ── API routes ──────────────────────────────────────────────────────────
    @api {
        # ADR-020: all backend routes namespaced under /api/* by default.
        # Two exceptions (Powens sandbox limitation: single redirect URI):
        #   - /auth/powens/* (OAuth initiate + callback)
        #   - /webhooks/powens (external POST from Powens, currently disabled)
        path /api/*
        path /auth/powens/*
        path /webhooks/powens
    }

    handle @api {
        reverse_proxy backend:8000 {
            # Cloudflare termine le TLS ; Caddy écoute en :80 et déduirait
            # X-Forwarded-Proto: http. On force https car le client a TOUJOURS
            # parlé en HTTPS à Cloudflare. Sans ça, backend génère du http://
            # dans request.url_for (cassait OAuth redirect_uri, cf ADR-014).
            header_up X-Forwarded-Proto https
        }
    }

    # ── Static SPA (everything else) ────────────────────────────────────────
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server

        @hashed {
            path *.js *.css *.woff2 *.png *.jpg *.svg *.ico
        }
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache, must-revalidate"
    }

    encode gzip zstd
    log {
        output stdout
    }
}
