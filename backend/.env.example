
# ─── Environnement ─────────────────────────────────────────
# "dev" → logs verbeux, tokens reset/verify loggués localement pour debug.
# "prod" → tokens jamais loggués, à envoyer par email.
APP_ENV=dev

# ─── Database ──────────────────────────────────────────────
# DATABASE_URL est automatiquement passée par docker-compose en runtime.
# Si tu lances uvicorn HORS Docker, défini-le ici manuellement :
# DATABASE_URL=postgresql+asyncpg://tangent:tangent_dev@localhost:5432/tangent

POSTGRES_PASSWORD=tangent_dev

# ─── Auth ──────────────────────────────────────────────────
# Secret pour signer les JWT. GÉNÈRE avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=GENERATE_ME_WITH_SECRETS_TOKEN_URLSAFE

COOKIE_NAME=tangent_auth
COOKIE_LIFETIME_SECONDS=604800   # 7 jours
COOKIE_SECURE=false              # false en dev (HTTP), true en prod (HTTPS only)

# ─── Powens (Phase 5) ──────────────────────────────────────
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# Clé Fernet pour chiffrer les tokens Powens en DB.
# GÉNÈRE avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POWENS_TOKEN_ENCRYPTION_KEY=GENERATE_ME_WITH_FERNET

# ─ OAuth (ADR-014) ─────────────────────────────────────────────
# Generate Fernet key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: backup in Bitwarden — loss = re-OAuth forced for all users.
OAUTH_TOKEN_ENCRYPTION_KEY=GENERATE_ME_WITH_FERNET_GENERATE_KEY

# Generate state secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=GENERATE_ME_WITH_SECRETS_TOKEN_URLSAFE_32

# Where the backend redirects after a successful OAuth callback
FRONTEND_URL=http://localhost:5173

# From GCP Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
